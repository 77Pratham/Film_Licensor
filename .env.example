GEMINI_API_KEY1=
GROQ_API_KEY=
TMDB_API_KEY=
OMDB_API_KEY=

# Database: defaults to local SQLite if not set
DATABASE_URL=sqlite:///pricing_cache.db

# Security
SERVICE_API_KEY=
REQUIRE_API_KEY=false

# Rate limiting (per IP)
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=60

# Cache invalidation
CACHE_TTL_SECONDS=86400
